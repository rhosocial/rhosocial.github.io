---
// ReportIssue.astro
// GitHub Issues feedback link with pre-filled template
const { slug } = Astro.props;
const BASE_URL = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const pagePath = `${BASE_URL}/blog/${slug}.html`;
// encodeURIComponent for query params
const enc = (s: string) => encodeURIComponent(s);
const baseIssueUrl = 'https://github.com/rhosocial/rhosocial.github.io/issues/new';
const issueTitle = `[Feedback] ${slug}`;
	const issueBody = `**Page**: ${pagePath}\n**Feedback**:\n\n---\n_Submitted via Report Issue button_`;
	const issueUrl = `${baseIssueUrl}?title=${enc(issueTitle)}&body=${enc(issueBody)}`;
---

<a href={issueUrl}
   target="_blank"
   rel="noopener noreferrer"
   class="report-issue"
   data-i18n="tools.reportIssue"
   data-track-event="tool"
   data-track-label="report-issue"
   data-track-value={slug}>
  Report Issue
</a>

<style>
  .report-issue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .report-issue:hover {
    color: var(--accent-secondary);
    border-color: var(--accent-secondary);
    text-decoration: none;
  }
  .report-issue::before {
    content: '△';
    font-size: 10px;
  }
</style>