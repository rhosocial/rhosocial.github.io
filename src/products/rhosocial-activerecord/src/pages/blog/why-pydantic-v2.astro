---
import BaseLayout from '../../layouts/BaseLayout.astro';
const __html = `<style>
:root, body {
  --code-keyword:   var(--tok-keyword);
  --code-class:     var(--tok-class);
  --code-fn:        var(--tok-func);
  --code-string:    var(--tok-string);
  --code-number:    var(--tok-num);
  --code-comment:   var(--tok-comment);
  --code-op:        var(--tok-op);
  --surface-0:      var(--bg-2);
  --surface-1:      var(--bg-elevated);
  --surface-2:      var(--bg-2);
  --surface-3:      color-mix(in srgb, var(--fg) 8%, var(--bg));
  --text-primary:   var(--fg);
  --text-secondary: var(--fg-muted);
  --text-muted:     var(--fg-faint);
  --accent-soft:    color-mix(in srgb, var(--accent) 15%, transparent);
  --accent-secondary:      var(--accent-2);
  --accent-secondary-soft: color-mix(in srgb, var(--accent-2) 12%, transparent);
  --accent-fg:      var(--bg);
  --ok:             var(--success);
  --ok-soft:        color-mix(in srgb, var(--success) 12%, transparent);
  --err:            var(--danger);
  --err-soft:       color-mix(in srgb, var(--danger) 12%, transparent);
  --info:           var(--info);
  --warn:           var(--warning, #f59e0b);
  --warn-soft:      color-mix(in srgb, var(--warning, #f59e0b) 12%, transparent);
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px;
  --space-5: 24px; --space-6: 32px; --space-7: 48px; --space-8: 64px;
  --radius-sm: 4px; --radius-md: 8px; --radius-lg: 12px; --radius-pill: 9999px;
}

.reveal { opacity:0; transform:translateY(24px); transition:opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }
.reveal-d1 { transition-delay:0.1s; }

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0; padding:0; background:var(--bg); color:var(--text-primary);
  font-family:var(--font-body); font-size:16px; line-height:1.8; -webkit-font-smoothing:antialiased}
:lang(zh) body{ line-height:1.85 }
a{color:var(--accent-secondary); text-decoration:none}
a:hover{text-decoration:underline}
code,pre,.mono{font-family:var(--font-mono)}
h1,h2,h3,h4{font-family:var(--font-display); font-weight:700; letter-spacing:-0.01em; margin:0}
h2{font-size:clamp(1.5rem,3vw,2rem); margin-top:var(--space-8); margin-bottom:var(--space-4); line-height:1.25}
h3{font-size:1.2rem; margin-top:var(--space-6); margin-bottom:var(--space-3); color:var(--text-primary)}
.container{max-width:780px; margin:0 auto; padding:0 var(--space-5)}

.hero{ padding:var(--space-8) 0 var(--space-6) }
.hero .eyebrow{ font-family:var(--font-mono); font-size:11px;
  letter-spacing:0.16em; text-transform:uppercase; color:var(--accent); margin-bottom:var(--space-4) }
.hero h1{ font-size:clamp(1.8rem,4.5vw,2.8rem); line-height:1.1; margin-bottom:var(--space-4) }
:lang(zh) .hero h1 em{
  font-style:normal; font-weight:700; color:var(--text-primary);
  text-decoration:underline; text-decoration-color:var(--accent);
  text-decoration-thickness:3px; text-underline-offset:8px }
.hero .lead{ color:var(--text-secondary); font-size:17px; max-width:680px; line-height:1.65 }
.hero .lead b{ color:var(--text-primary); font-weight:600 }

.article-body{ padding-bottom:var(--space-8) }
.article-body p{ margin:0 0 var(--space-4); color:var(--text-primary) }
.article-body p.lead{ font-size:17px; color:var(--text-secondary); line-height:1.7 }
.article-body ul,.article-body ol{ margin:0 0 var(--space-4); padding-left:var(--space-5); color:var(--text-primary) }
.article-body li{ margin-bottom:var(--space-2) }
.article-body strong{ color:var(--text-primary); font-weight:600 }
.article-body code{ color:var(--accent); background:var(--accent-soft); padding:1px 6px; border-radius:3px; font-size:14px }
.article-body pre{ background:var(--surface-1); border:1px solid var(--border);
  border-radius:var(--radius-md); padding:var(--space-5); overflow-x:auto;
  font-family:var(--font-mono); font-size:13px; line-height:1.7; margin:0 0 var(--space-5) }
.article-body pre code{ background:none; color:var(--text-primary); padding:0; font-size:13px }
.article-body blockquote{ margin:0 0 var(--space-5); padding:var(--space-4) var(--space-5);
  border-left:3px solid var(--accent); background:var(--surface-1); border-radius:0 var(--radius-md) var(--radius-md) 0;
  color:var(--text-secondary); font-size:15px; line-height:1.7 }
.article-body blockquote strong{ color:var(--text-primary) }
.article-body blockquote code{ color:var(--accent-secondary) }
.article-body h2 code,.article-body h3 code{ font-size:inherit }
.article-body .callout{ margin:0 0 var(--space-5); padding:var(--space-4) var(--space-5);
  border-radius:var(--radius-md); background:var(--accent-soft); border:1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  color:var(--text-secondary); font-size:14px; line-height:1.6 }
.article-body .callout strong{ color:var(--accent) }
.article-body hr{ border:none; border-top:1px solid var(--border); margin:var(--space-7) 0 }
.article-body .tok-kw{color:var(--code-keyword)}
.article-body .tok-cls{color:var(--code-class)}
.article-body .tok-fn{color:var(--code-fn)}
.article-body .tok-s{color:var(--code-string)}
.article-body .tok-c{color:var(--code-comment);font-style:italic}
.article-body .tok-op{color:var(--code-op)}
.article-body .tok-num{color:var(--code-number)}

.back-link{ display:inline-flex; align-items:center; gap:var(--space-2);
  font-family:var(--font-mono); font-size:12px; color:var(--text-muted);
  margin-bottom:var(--space-6); transition:color .2s }
.back-link:hover{ color:var(--accent-secondary); text-decoration:none }
</style>
<main class="page">
  <section class="hero reveal">
    <div class="container">
      <a href="./index.html" class="back-link">&larr; <span data-i18n="hero.back">Back to Blog</span></a>
      <div class="eyebrow" data-i18n="hero.eyebrow">2026-05-13 · Design · Architecture</div>
      <h1 data-i18n="hero.title">为什么我们选择 Pydantic v2 作为 ActiveRecord 的基类</h1>
      <p class="lead" data-i18n="hero.sub">类型安全、验证管道与 IDE 体验的取舍。</p>
    </div>
  </section>

  <div id="post-body" class="container article-body" data-slug="why-pydantic-v2"></div>

  <style>
.series-nav {
  margin: var(--space-8) 0 var(--space-4);
  padding: var(--space-6);
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  max-width: 780px;
  margin-left: auto;
  margin-right: auto;
}
.series-nav-inner {
  display: flex;
  flex-direction: column;
}
.series-nav-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--border);
}
.series-nav-label {
  font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--accent);
}
.series-nav-name {
  font-family: var(--font-display); font-size: 1rem;
  font-weight: 700; color: var(--text-primary);
}
.series-nav-list {
  list-style: none; padding: 0; margin: 0;
  display: flex; flex-direction: column; gap: var(--space-2);
}
.series-nav-item {
  display: flex; align-items: center; gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  font-size: 14px;
  transition: background 0.2s;
}
.series-nav-item.active {
  background: var(--accent-soft);
  color: var(--text-primary);
  font-weight: 600;
}
.series-nav-item.active::before {
  content: '▸';
  color: var(--accent);
  font-family: var(--font-mono);
}
.series-nav-item.inactive {
  color: var(--text-muted);
}
.series-nav-item.inactive::before {
  content: '·';
  color: var(--text-muted);
  font-family: var(--font-mono);
}
.series-nav-item.inactive:hover {
  background: var(--surface-2);
}
.series-nav-item.coming-soon {
  color: var(--text-muted);
  font-style: italic;
  opacity: 0.6;
}
.series-nav-item.coming-soon::before {
  content: '○';
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 10px;
}
</style>

<div id="series-article-nav" class="container series-nav reveal reveal-d1" data-slug="why-pydantic-v2"></div>

  <script src="../assets/blog-post.js"></script>
  <script src="../assets/series-nav.js"></script></main>
<script>
(function(){var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add("visible");o.unobserve(e.target)}})},{threshold:.12});document.querySelectorAll(".reveal").forEach(function(e){o.observe(e)})})();void 0
</script>`;
---

<BaseLayout title="rhosocial ActiveRecord — 为什么选择 Pydantic v2" variant="blog">
  <Fragment set:html={__html} />
</BaseLayout>
