---
import BaseLayout from '../../layouts/BaseLayout.astro';
const __html = `<style>
:root, body {
  --code-keyword:   var(--tok-keyword);
  --code-class:     var(--tok-class);
  --code-fn:        var(--tok-func);
  --code-string:    var(--tok-string);
  --code-number:    var(--tok-num);
  --code-comment:   var(--tok-comment);
  --code-op:        var(--tok-op);
  --surface-0:      var(--bg-2);
  --surface-1:      var(--bg-elevated);
  --surface-2:      var(--bg-2);
  --surface-3:      color-mix(in srgb, var(--fg) 8%, var(--bg));
  --text-primary:   var(--fg);
  --text-secondary: var(--fg-muted);
  --text-muted:     var(--fg-faint);
  --accent-soft:    color-mix(in srgb, var(--accent) 15%, transparent);
  --accent-secondary:      var(--accent-2);
  --accent-secondary-soft: color-mix(in srgb, var(--accent-2) 12%, transparent);
  --accent-fg:      var(--bg);
  --ok:             var(--success);
  --ok-soft:        color-mix(in srgb, var(--success) 12%, transparent);
  --err:            var(--danger);
  --err-soft:       color-mix(in srgb, var(--danger) 12%, transparent);
  --info:           var(--info);
  --warn:           var(--warning, #f59e0b);
  --warn-soft:      color-mix(in srgb, var(--warning, #f59e0b) 12%, transparent);
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px;
  --space-5: 24px; --space-6: 32px; --space-7: 48px; --space-8: 64px;
  --radius-sm: 4px; --radius-md: 8px; --radius-lg: 12px; --radius-pill: 9999px;
}

.reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}.reveal.visible{opacity:1;transform:translateY(0)}.reveal-d1{transition-delay:.1s}.reveal-d2{transition-delay:.2s}

.blog-card {
  display: flex; flex-direction: column;
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  text-decoration: none;
  position: relative;
  overflow: hidden;
  transition: border-color 0.25s, transform 0.25s;
}
.blog-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--accent);
  opacity: 0.5;
}
.blog-card:hover {
  border-color: var(--border-strong);
  transform: translateY(-3px);
}
.blog-card-date {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--text-muted); letter-spacing: 0.06em;
  margin-bottom: var(--space-3);
}
.blog-card.placeholder {
  opacity: 0.5;
  pointer-events: none;
}
.blog-card.placeholder:hover {
  transform: none;
  border-color: var(--border);
}

.series-section {
  margin-bottom: var(--space-8);
}
.series-header {
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-2);
  border-bottom: 2px solid var(--accent);
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}
.series-name {
  font-family: var(--font-display);
  font-size: 1.2rem; font-weight: 700;
  color: var(--text-primary);
}
.series-count {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--text-muted);
}
.series-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: var(--space-5);
}
.blog-card-cats {
  display: flex; gap: var(--space-2); flex-wrap: wrap;
  margin-bottom: var(--space-3);
}
.blog-card-cat {
  font-family: var(--font-mono); font-size: 10px;
  padding: 2px 8px; border-radius: var(--radius-pill);
  background: var(--accent-soft);
  color: var(--accent);
  border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
}
.blog-card-title {
  font-size: 1.15rem; font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-2);
  line-height: 1.35;
}
.blog-card-sub {
  font-size: 13px; color: var(--text-secondary);
  line-height: 1.55;
  margin-bottom: var(--space-3);
  font-style: italic;
  flex: 1;
}

.blog-card-read {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--accent-secondary);
  font-weight: 600;
}
</style>
<main class="page">
  <section class="hero section reveal">
    <div class="container hero-inner">
      <div class="hero-eyebrow rise" data-i18n="hero.eyebrow">Blog</div>
      <h1 class="hero-title rise" data-i18n="hero.title">rhosocial ActiveRecord <em>技术博客</em>。</h1>
      <p class="hero-sub rise" data-i18n="hero.sub">产品背后的设计决策、实现细节与最佳实践。</p>
    </div>
  </section>

  <section class="section reveal reveal-d1">
    <div class="container">
<div class="section-header">
        <div class="section-label" data-i18n="topics.label">POSTS</div>
        <h2 class="section-title" data-i18n="topics.title">最新<em>文章</em>。</h2>
      </div>
      <div id="series-index-container"></div>
    </div>
  </section><script src="./posts-data/zh-cn.js"></script>
  <script src="./posts-data/en-us.js"></script>
  <script src="../assets/series-nav.js"></script>
  <script src="../assets/blog-index.js"></script>
</main>
<script>
(function(){var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add("visible");o.unobserve(e.target)}})},{threshold:.12});document.querySelectorAll(".reveal").forEach(function(e){o.observe(e)})})();void 0
</script>`;
---

<BaseLayout title="rhosocial ActiveRecord — Blog" variant="blog">
  <Fragment set:html={__html} />
</BaseLayout>
