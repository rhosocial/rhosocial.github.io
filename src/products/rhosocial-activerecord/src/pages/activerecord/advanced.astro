---
import BaseLayout from '../../layouts/BaseLayout.astro';
const __html = `<style>
:root, body {
  --code-keyword:   var(--tok-keyword);
  --code-class:     var(--tok-class);
  --code-fn:        var(--tok-func);
  --code-string:    var(--tok-string);
  --code-number:    var(--tok-num);
  --code-comment:   var(--tok-comment);
  --code-op:        var(--tok-op);
  --surface-0:      var(--bg-2);
  --surface-1:      var(--bg-elevated);
  --surface-2:      var(--bg-2);
  --surface-3:      color-mix(in srgb, var(--fg) 8%, var(--bg));
  --text-primary:   var(--fg);
  --text-secondary: var(--fg-muted);
  --text-muted:     var(--fg-faint);
  --accent-soft:    color-mix(in srgb, var(--accent) 15%, transparent);
  --accent-secondary:      var(--accent-2);
  --accent-secondary-soft: color-mix(in srgb, var(--accent-2) 12%, transparent);
  --accent-fg:      var(--bg);
  --ok:             var(--success);
  --ok-soft:        color-mix(in srgb, var(--success) 12%, transparent);
  --err:            var(--danger);
  --err-soft:       color-mix(in srgb, var(--danger) 12%, transparent);
  --info:           var(--info);
  --warn:           var(--warning, #f59e0b);
  --warn-soft:      color-mix(in srgb, var(--warning, #f59e0b) 12%, transparent);
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px;
  --space-5: 24px; --space-6: 32px; --space-7: 48px; --space-8: 64px;
  --radius-sm: 4px; --radius-md: 8px; --radius-lg: 12px; --radius-pill: 9999px;
}
.reveal { opacity:0; transform:translateY(24px); transition:opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }
.reveal-d1 { transition-delay:0.1s; }
.reveal-d2 { transition-delay:0.2s; }
</style>
<main class="page">
  <section class="hero section reveal">
    <div class="container hero-inner">
      <div class="hero-eyebrow rise"><a href="./index.html">&larr; <span data-i18n="hero.back">ActiveRecord</span></div>
      <h1 class="hero-title rise">Advanced</h1>
      <p class="hero-sub rise" data-i18n="hero.sub">性能优化、调试技巧、常见模式。</p>
    </div>
  </section>
  <section class="section reveal reveal-d1">
    <div class="container">
      <div class="section-header">
        <div class="section-label" data-i18n="performance.label">Performance</div>
        <h2 class="section-title" data-i18n="performance.title">性能优化。</h2>
      </div>
      <div class="code-block" style="margin-top: 24px;"><div class="code-header"><div class="code-dots"><span></span><span></span><span></div><span class="code-filename">main.py</span></div>
        <div class="code-body"><pre><span class="tok-c"># 批量操作</span>
users = [<span class="tok-cls">User</span>(username=f<span class="tok-s">'user_{i}'</span>, email=f<span class="tok-s">'u{i}@example.com'</span>) <span class="tok-kw">for</span> i <span class="tok-kw">in</span> <span class="tok-kw">range</span>(<span class="tok-num">1000</span>)]
<span class="tok-cls">User</span>.bulk_create(users)

<span class="tok-c"># 预加载避免 N+1</span>
users = <span class="tok-cls">User</span>.query().with_(<span class="tok-s">'posts'</span>, <span class="tok-s">'posts.comments'</span>).all()

<span class="tok-c"># 聚合查询优化</span>
total = <span class="tok-cls">User</span>.query().count()
avg = <span class="tok-cls">User</span>.query().avg(<span class="tok-cls">User</span>.c.age)</pre></div>
      </div>
    </div>
  </section>
  <section class="section reveal reveal-d1">
    <div class="section">
    <div class="container">
      <div class="section-header">
        <div class="section-label" data-i18n="debugging.label">Debugging</div>
        <h2 class="section-title" data-i18n="debugging.title">调试技巧。</h2>
      </div>
      <div class="code-block" style="margin-top: 24px;"><div class="code-header"><div class="code-dots"><span></span><span></span><span></div><span class="code-filename">main.py</span></div>
        <div class="code-body"><pre><span class="tok-c"># 查看生成的 SQL</span>
sql, params = <span class="tok-cls">User</span>.query().where(<span class="tok-cls">User</span>.c.status == <span class="tok-s">'active'</span>).to_sql()

<span class="tok-c"># EXPLAIN 查询计划</span>
plan = <span class="tok-cls">User</span>.query().where(<span class="tok-cls">User</span>.c.age > <span class="tok-num">18</span>).explain().aggregate()</pre></div>
      </div>
    </div>
  </section></main>
<script>
(function(){var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add("visible");o.unobserve(e.target)}})},{threshold:.12});document.querySelectorAll(".reveal").forEach(function(e){o.observe(e)})})();void 0
</script>`;
---

<BaseLayout title="rhosocial ActiveRecord — Advanced" variant="ar">
  <Fragment set:html={__html} />
</BaseLayout>
