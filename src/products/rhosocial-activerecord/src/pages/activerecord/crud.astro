---
import BaseLayout from '../../layouts/BaseLayout.astro';
const __html = `<style>
:root, body {
  --code-keyword:   var(--tok-keyword);
  --code-class:     var(--tok-class);
  --code-fn:        var(--tok-func);
  --code-string:    var(--tok-string);
  --code-number:    var(--tok-num);
  --code-comment:   var(--tok-comment);
  --code-op:        var(--tok-op);
  --surface-0:      var(--bg-2);
  --surface-1:      var(--bg-elevated);
  --surface-2:      var(--bg-2);
  --surface-3:      color-mix(in srgb, var(--fg) 8%, var(--bg));
  --text-primary:   var(--fg);
  --text-secondary: var(--fg-muted);
  --text-muted:     var(--fg-faint);
  --accent-soft:    color-mix(in srgb, var(--accent) 15%, transparent);
  --accent-secondary:      var(--accent-2);
  --accent-secondary-soft: color-mix(in srgb, var(--accent-2) 12%, transparent);
  --accent-fg:      var(--bg);
  --ok:             var(--success);
  --ok-soft:        color-mix(in srgb, var(--success) 12%, transparent);
  --err:            var(--danger);
  --err-soft:       color-mix(in srgb, var(--danger) 12%, transparent);
  --info:           var(--info);
  --warn:           var(--warning, #f59e0b);
  --warn-soft:      color-mix(in srgb, var(--warning, #f59e0b) 12%, transparent);
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px;
  --space-5: 24px; --space-6: 32px; --space-7: 48px; --space-8: 64px;
  --radius-sm: 4px; --radius-md: 8px; --radius-lg: 12px; --radius-pill: 9999px;
}
.reveal { opacity:0; transform:translateY(24px); transition:opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }
.reveal-d1 { transition-delay:0.1s; }
.reveal-d2 { transition-delay:0.2s; }
</style>
<main class="page">
  <section class="hero section reveal">
    <div class="container hero-inner">
      <div class="hero-eyebrow rise"><a href="./index.html">&larr; <span data-i18n="hero.back">ActiveRecord</span></div>
      <h1 class="hero-title rise">CRUD</h1>
      <p class="hero-sub rise" data-i18n="hero.sub">Create, Read, Update, Delete。</p>
    </div>
  </section>
  <section class="section reveal reveal-d1">
    <div class="container">
      <div class="section-header">
        <div class="section-label" data-i18n="create.label">Create</div>
        <h2 class="section-title" data-i18n="create.title">创建记录。</h2>
      </div>
      <div class="code-block" style="margin-top: 24px;"><div class="code-header"><div class="code-dots"><span></span><span></span><span></div><span class="code-filename">main.py</span></div>
        <div class="code-body"><pre><span class="tok-c"># 方式一：实例化后保存</span>
user = <span class="tok-cls">User</span>(username=<span class="tok-s">'Alice'</span>, email=<span class="tok-s">'alice@example.com'</span>)
user.save()

<span class="tok-c"># 方式二：直接创建并保存</span>
user = <span class="tok-cls">User</span>.create(username=<span class="tok-s">'Bob'</span>, email=<span class="tok-s">'bob@example.com'</span>)</pre></div>
      </div>
    </div>
  </section>
  <section class="section reveal reveal-d1">
    <div class="container">
      <div class="section-header">
        <div class="section-label" data-i18n="read.label">Read</div>
        <h2 class="section-title" data-i18n="read.title">读取记录。</h2>
      </div>
      <div class="code-block" style="margin-top: 24px;"><div class="code-header"><div class="code-dots"><span></span><span></span><span></div><span class="code-filename">main.py</span></div>
        <div class="code-body"><pre><span class="tok-c"># 按主键获取 (find_one 接受 PK 值作为参数)</span>
user = <span class="tok-cls">User</span>.find_one(1)

<span class="tok-c"># 条件查询 (query().where().one())</span>
user = <span class="tok-cls">User</span>.query().where(<span class="tok-cls">User</span>.c.username == <span class="tok-s">'Alice'</span>).one()

<span class="tok-c"># 获取全部 (query().all())</span>
users = <span class="tok-cls">User</span>.query().all()</pre></div>
      </div>
    </div>
  </section>
  <section class="section reveal reveal-d1">
    <div class="container">
      <div class="section-header">
        <div class="section-label" data-i18n="update.label">Update</div>
        <h2 class="section-title" data-i18n="update.title">更新记录。</h2>
      </div>
      <div class="code-block" style="margin-top: 24px;"><div class="code-header"><div class="code-dots"><span></span><span></span><span></div><span class="code-filename">main.py</span></div>
        <div class="code-body"><pre><span class="tok-c"># 修改属性后保存</span>
user = <span class="tok-cls">User</span>.find_one(1)
user.email = <span class="tok-s">'new@example.com'</span>
user.save()

<span class="tok-c"># 批量更新 (query().where().update())</span>
<span class="tok-cls">User</span>.query().where(<span class="tok-cls">User</span>.c.username == <span class="tok-s">'Alice'</span>).update({email: <span class="tok-s">'alice@new.com'</span>})</pre></div>
      </div>
    </div>
  </section>
  <section class="section reveal reveal-d1">
    <div class="container">
      <div class="section-header">
        <div class="section-label" data-i18n="delete.label">Delete</div>
        <h2 class="section-title" data-i18n="delete.title">删除记录。</h2>
      </div>
      <div class="code-block" style="margin-top: 24px;"><div class="code-header"><div class="code-dots"><span></span><span></span><span></div><span class="code-filename">main.py</span></div>
        <div class="code-body"><pre><span class="tok-c"># 实例方法删除</span>
user = <span class="tok-cls">User</span>.find_one(1)
user.delete()

<span class="tok-c"># 条件删除 (query().where().delete())</span>
<span class="tok-cls">User</span>.query().where(<span class="tok-cls">User</span>.c.username == <span class="tok-s">'Alice'</span>).delete()</pre></div>
      </div>
    </div>
  </section></main>
<script>
(function(){var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add("visible");o.unobserve(e.target)}})},{threshold:.12});document.querySelectorAll(".reveal").forEach(function(e){o.observe(e)})})();void 0
</script>`;
---

<BaseLayout title="rhosocial ActiveRecord — CRUD" variant="ar">
  <Fragment set:html={__html} />
</BaseLayout>
