<script>
/* ============ tab switching ============ */
document.querySelectorAll('[data-tabset]').forEach(row => {
  const tabset = row.dataset.tabset;
  const allBtns = row.querySelectorAll('.tab-btn');
  const allPanes = row.parentElement.querySelectorAll('.tab-pane');

  allBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      allBtns.forEach(b => b.classList.remove('on'));
      btn.classList.add('on');
      const target = btn.dataset.tab;
      allPanes.forEach(p => {
        p.classList.toggle('on', p.dataset.tab === target);
      });
    });
  });
});

/* ============ A9 N+1 Visualizer ============ */
const qList    = document.getElementById('q-list');
const tlCount  = document.getElementById('tl-count');
const tlTitle  = document.getElementById('tl-title');
const tlFoot   = document.getElementById('tl-foot');
const pyTitle  = document.getElementById('py-title');
const nplus1Py = document.getElementById('nplus1-py');
const nRange   = document.getElementById('n-range');
const nDisplay = document.getElementById('n-display');
const playBtn  = document.getElementById('play-btn');
const resetBtn = document.getElementById('reset-btn');
const modeBtns = document.querySelectorAll('.mode-btn');

let currentMode = 'naive';
let currentN = parseInt(nRange.value);
let playTimer = null;

const namesPool = ['alice','bob','carol','dave','eve','frank','grace','henry','ivy','jack','kate','liam','mia','noah','olivia','pete','quinn','riley','sam','tina'];

function buildNaiveQueries(n) {
  const list = [];
  list.push({
    main: true,
    sql: '<span class="skw">SELECT</span> * <span class="skw">FROM</span> <span class="stbl">users</span>',
    tag: { class:'is-good', text:'1 次' },
    label: 'main'
  });
  for (let i = 0; i < n; i++) {
    list.push({
      relation: true,
      sql: \`<span class="skw">SELECT</span> * <span class="skw">FROM</span> <span class="stbl">orders</span> <span class="skw">WHERE</span> user_id = <span class="sval">\${i+1}</span>\`,
      tag: { class:'is-bad', text:\`+\${i+1}\` },
      label: \`for user=\${namesPool[i] || 'u'+(i+1)}\`
    });
  }
  return list;
}

function buildEagerQueries(n) {
  const ids = Array.from({length:n}, (_,i) => i+1).join(', ');
  return [
    {
      main: true,
      sql: '<span class="skw">SELECT</span> * <span class="skw">FROM</span> <span class="stbl">users</span>',
      tag: { class:'is-good', text:'1 次' },
      label: 'main'
    },
    {
      eager: true,
      sql: \`<span class="skw">SELECT</span> * <span class="skw">FROM</span> <span class="stbl">orders</span> <span class="skw">WHERE</span> user_id <span class="skw">IN</span> (<span class="sval">\${ids}</span>)\`,
      tag: { class:'is-good', text:'1 次' },
      label: 'eager: orders for ALL users'
    }
  ];
}

function renderQueries(queries, animate) {
  qList.innerHTML = '';
  queries.forEach((q, i) => {
    const li = document.createElement('li');
    let cls = 'q-item';
    if (q.main) cls += ' is-main';
    if (q.relation) cls += ' is-relation';
    if (q.eager) cls += ' is-eager';
    li.className = cls;

    li.innerHTML =
      '<span class="q-num">[' + String(i+1).padStart(2,'0') + ']</span>' +
      '<span class="q-sql">' + q.sql + '</span>' +
      '<span class="q-tag ' + q.tag.class + '">' + q.tag.text + '</span>' +
      '<span style="color:var(--text-muted); margin-left:8px; font-size:11px">' + q.label + '</span>';
    qList.appendChild(li);

    if (animate) {
      setTimeout(function(){ li.classList.add('shown'); }, 60 + i * 80);
    } else {
      li.classList.add('shown');
    }
  });
}

function applyMode(mode, animate) {
  currentMode = mode;
  const queries = mode === 'naive' ? buildNaiveQueries(currentN) : buildEagerQueries(currentN);
  const total = queries.length;

  tlCount.textContent = total;
  tlCount.className = 'stat-num ' + (mode === 'naive' ? 'is-bad' : 'is-good');

  if (mode === 'naive') {
    tlTitle.textContent = '朴素写法 · 循环 N 次取关系';
    tlFoot.className = 'q-list-foot is-bad';
    tlFoot.innerHTML = '<strong>问题:</strong>&nbsp;每访问一个 user.orders 都跑一条独立 SQL。1 + ' + currentN + ' = ' + total + ' 次。';
    pyTitle.textContent = '业务代码 · 朴素写法';
    nplus1Py.innerHTML =
      '<span class="cm"># 1 次:取所有 user</span>\\n' +
      'users = User.<span class="fn">query</span>().<span class="fn">all</span>()        <span class="cm"># SELECT * FROM users</span>\\n\\n' +
      '<span class="cm"># 然后循环 ' + currentN + ' 次:对每个 user 单独取 orders</span>\\n' +
      '<span class="kw">for</span> user <span class="kw">in</span> users:\\n' +
      '    <span class="kw">for</span> order <span class="kw">in</span> user.<span class="fn">orders</span>.<span class="fn">all</span>():   <span class="hl">← ' + currentN + ' 次额外查询</span>\\n' +
      '        <span class="fn">print</span>(user.name, order.amount)\\n\\n' +
      '<span class="cm"># 总计 1 + ' + currentN + ' = ' + total + ' 次 SQL · 不可接受</span>';
  } else {
    tlTitle.textContent = '.with("orders") · Eager loading';
    tlFoot.className = 'q-list-foot is-good';
    tlFoot.innerHTML = '<strong>结果:</strong>&nbsp;无论 N = ' + currentN + ' 多大,固定 <strong>2 次</strong> 查询。';
    pyTitle.textContent = '业务代码 · Eager loading';
    nplus1Py.innerHTML =
      '<span class="cm"># 一次性预加载所有 user 及其 orders</span>\\n' +
      'users = User.<span class="fn">query</span>().<span class="fn">with_</span>(<span class="str">"orders"</span>).<span class="fn">all</span>()\\n' +
      '              <span class="hl">↑ 关键</span>\\n\\n' +
      '<span class="cm"># 此时 user.orders 已经在内存里,循环不再触发 SQL</span>\\n' +
      '<span class="kw">for</span> user <span class="kw">in</span> users:\\n' +
      '    <span class="kw">for</span> order <span class="kw">in</span> user.<span class="fn">orders</span>.<span class="fn">all</span>():   <span class="cm"># ✓ 不查询了</span>\\n' +
      '        <span class="fn">print</span>(user.name, order.amount)\\n\\n' +
      '<span class="cm"># 总计 2 次 SQL · 与 N 无关 · 推荐</span>';
  }

  modeBtns.forEach(function(b){ b.classList.toggle('on', b.dataset.mode === mode); });
  renderQueries(queries, animate);
}

modeBtns.forEach(function(b) {
  b.addEventListener('click', function(){ applyMode(b.dataset.mode, true); });
});

nRange.addEventListener('input', function(e) {
  currentN = parseInt(e.target.value);
  nDisplay.textContent = currentN;
  applyMode(currentMode, false);
});

playBtn.addEventListener('click', function() {
  if (playTimer) clearTimeout(playTimer);
  applyMode('naive', true);
  playTimer = setTimeout(function() {
    applyMode('eager', true);
  }, 1400);
});

resetBtn.addEventListener('click', function() {
  if (playTimer) clearTimeout(playTimer);
  currentN = 8;
  nRange.value = 8;
  nDisplay.textContent = 8;
  applyMode('naive', false);
});

// initial render
applyMode('naive', false);
</script>

<script>
/* scroll reveal observer */
(function(){
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });
})();
</script>`;
