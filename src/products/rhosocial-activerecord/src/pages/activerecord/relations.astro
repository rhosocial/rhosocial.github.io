---
import BaseLayout from '../../layouts/BaseLayout.astro';
const __html = `<style>
:root, body {
  --code-keyword:   var(--tok-keyword);
  --code-class:     var(--tok-class);
  --code-fn:        var(--tok-func);
  --code-string:    var(--tok-string);
  --code-number:    var(--tok-num);
  --code-comment:   var(--tok-comment);
  --code-op:        var(--tok-op);

  --surface-0:      var(--bg-2);
  --surface-1:      var(--bg-elevated);
  --surface-2:      var(--bg-2);
  --surface-3:      color-mix(in srgb, var(--fg) 8%, var(--bg));
  --text-primary:   var(--fg);
  --text-secondary: var(--fg-muted);
  --text-muted:     var(--fg-faint);
  --accent-soft:    color-mix(in srgb, var(--accent) 15%, transparent);
  --accent-secondary:      var(--accent-2);
  --accent-secondary-soft: color-mix(in srgb, var(--accent-2) 12%, transparent);
  --accent-fg:      var(--bg);
  --ok:             var(--success);
  --ok-soft:        color-mix(in srgb, var(--success) 12%, transparent);
  --err:            var(--danger);
  --err-soft:       color-mix(in srgb, var(--danger) 12%, transparent);
  --info:           var(--info);
  --warn:           var(--warning, #f59e0b);
  --warn-soft:      color-mix(in srgb, var(--warning, #f59e0b) 12%, transparent);
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px;
  --space-5: 24px; --space-6: 32px; --space-7: 48px; --space-8: 64px;
  --radius-sm: 4px; --radius-md: 8px; --radius-lg: 12px; --radius-pill: 9999px;
}

.reveal { opacity:0; transform:translateY(24px); transition:opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }
.reveal-d1 { transition-delay:0.1s; }
.reveal-d2 { transition-delay:0.2s; }

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0; padding:0; background:var(--bg); color:var(--text-primary);
  font-family:var(--font-body); font-size:15px; line-height:1.7; -webkit-font-smoothing:antialiased}
:lang(zh) body{ line-height:1.75 }
a{color:var(--accent-secondary); text-decoration:none}
a:hover{text-decoration:underline}
code,pre,.mono{font-family:var(--font-mono)}
h1,h2,h3,h4{font-family:var(--font-display); font-weight:700; letter-spacing:-0.01em; margin:0}
.container{max-width:1180px; margin:0 auto; padding:0 var(--space-5)}

.hero{ padding:var(--space-8) 0 var(--space-7) }
.hero .eyebrow{ font-family:var(--font-mono); font-size:11px;
  letter-spacing:0.16em; text-transform:uppercase; color:var(--accent); margin-bottom:var(--space-3) }
.hero h1{ font-size:clamp(2rem,5.5vw,3.6rem); line-height:1.05; margin-bottom:var(--space-4) }
:lang(zh) .hero h1 em{
  font-style:normal; font-weight:700; color:var(--text-primary);
  text-decoration:underline; text-decoration-color:var(--accent);
  text-decoration-thickness:3px; text-underline-offset:8px }
.hero .lead{ color:var(--text-secondary); font-size:17px; max-width:720px; line-height:1.65 }
.hero .lead b{ color:var(--text-primary); font-weight:600 }
.hero .lead code{ color:var(--accent); background:var(--accent-soft); padding:1px 6px; border-radius:3px; font-size:13px }
.hero-pills{ display:flex; gap:var(--space-2); flex-wrap:wrap; margin-top:var(--space-5) }
.pill{ display:inline-flex; padding:5px 12px; border-radius:9999px;
  background:var(--accent-soft); color:var(--accent); border:1px solid var(--accent-soft);
  font-family:var(--font-mono); font-size:11px; font-weight:700; letter-spacing:0.04em }
.pill.is-secondary{ background:var(--accent-secondary-soft); color:var(--accent-secondary); border-color:var(--accent-secondary-soft) }
.pill.is-ghost{ background:transparent; color:var(--text-secondary); border-color:var(--border) }

.sect{ margin:var(--space-8) 0; padding-top:var(--space-7); border-top:1px solid var(--border) }
.sect-tag{ display:inline-block; font-family:var(--font-mono); font-size:11px;
  letter-spacing:0.12em; text-transform:uppercase;
  color:var(--accent); border:1px solid var(--accent);
  padding:var(--space-1) var(--space-3); border-radius:var(--radius-sm); margin-bottom:var(--space-3) }
.sect h2{ font-size:clamp(1.6rem,3.5vw,2.4rem); line-height:1.15; margin-bottom:var(--space-4) }
:lang(zh) .sect h2 em{
  font-style:normal; font-weight:700; color:var(--text-primary);
  text-decoration:underline; text-decoration-color:var(--accent);
  text-decoration-thickness:3px; text-underline-offset:6px }
.sect .intro{ color:var(--text-secondary); max-width:780px; font-size:16px; margin-bottom:var(--space-5) }
.sect .intro b{ color:var(--text-primary) }
.sect .intro code{ color:var(--accent); background:var(--accent-soft); padding:1px 6px; border-radius:3px; font-size:13px }

.code-block{ background:var(--surface-2); border:1px solid var(--border);
  border-radius:var(--radius-md); padding:var(--space-5);
  font-family:var(--font-mono); font-size:13px; line-height:1.85; overflow-x:auto;
  direction:ltr; unicode-bidi:embed }
.code-block .cm{ color:var(--code-comment); font-style:italic }
.code-block .kw{ color:var(--code-keyword) }
.code-block .cls{ color:var(--code-class) }
.code-block .fn{ color:var(--code-fn) }
.code-block .str{ color:var(--code-string) }
.code-block .num{ color:var(--code-number) }
.code-block .op{ color:var(--code-op) }
.code-block .skw{ color:var(--accent-secondary); font-weight:700 }
.code-block .stbl{ color:var(--accent) }
.code-block .sval{ color:var(--ok) }
.code-block .scm{ color:var(--code-comment); font-style:italic }
.code-block .hl{ background:var(--accent-soft); border-radius:3px; padding:0 4px; color:var(--accent) }

.code-panel{ background:var(--surface-0); border:1px solid var(--border-strong);
  border-radius:var(--radius-lg); overflow:hidden }
.code-panel-header{ padding:8px var(--space-4);
  background:var(--surface-1); border-bottom:1px solid var(--border);
  display:flex; align-items:center; gap:var(--space-2);
  font-family:var(--font-mono); font-size:11px;
  color:var(--text-muted); letter-spacing:0.06em; text-transform:uppercase }
.code-panel-header .dot{ width:6px; height:6px; border-radius:50%; background:var(--accent) }
.code-panel-header.is-sql .dot{ background:var(--accent-secondary) }
.code-panel-header.is-warn .dot{ background:var(--err) }
.code-panel-header.is-ok .dot{ background:var(--ok) }
.code-panel pre.code-block{ border:none; border-radius:0 }

.rel-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(310px,1fr));
  gap:var(--space-4); margin-top:var(--space-5) }
.rel-card{ background:var(--surface-1); border:1px solid var(--border);
  border-radius:var(--radius-md); padding:var(--space-5); position:relative; overflow:hidden }
.rel-card::before{ content:''; position:absolute; top:0; left:0; right:0; height:3px;
  background:var(--accent); opacity:0.5 }
.rel-card.is-belongs::before{ background:var(--accent-secondary) }
.rel-card.is-has-one::before{ background:var(--info) }
.rel-card .rel-icon{ font-family:var(--font-mono); font-size:18px;
  color:var(--accent); margin-bottom:var(--space-2); letter-spacing:0.1em }
.rel-card.is-belongs .rel-icon{ color:var(--accent-secondary) }
.rel-card.is-has-one .rel-icon{ color:var(--info) }
.rel-card h3{ font-size:18px; margin-bottom:var(--space-2); font-family:var(--font-mono); font-weight:700 }
.rel-card .rel-desc{ font-size:13px; color:var(--text-secondary); line-height:1.6; margin-bottom:var(--space-3) }
.rel-card .rel-pair{ font-family:var(--font-mono); font-size:12px;
  background:var(--surface-2); border-radius:var(--radius-sm);
  padding:var(--space-2) var(--space-3); color:var(--text-muted) }
.rel-card .rel-pair b{ color:var(--text-primary); font-weight:700 }

.tabs-row{ display:flex; gap:var(--space-1); flex-wrap:wrap; margin-bottom:var(--space-3) }
.tab-btn{ font-family:var(--font-mono); font-size:12px;
  padding:var(--space-2) var(--space-4);
  border:1px solid var(--border); background:transparent; color:var(--text-secondary);
  border-radius:var(--radius-sm); cursor:pointer; transition:.15s }
.tab-btn:hover{ color:var(--text-primary); border-color:var(--accent) }
.tab-btn.on{ background:var(--accent); color:var(--accent-fg); border-color:var(--accent); font-weight:700 }
.tab-pane{ display:none }
.tab-pane.on{ display:block }

.nplus1-block{ margin-top:var(--space-4) }
.nplus1-mode-row{ display:flex; gap:var(--space-2); margin-bottom:var(--space-4); flex-wrap:wrap }
.mode-btn{ font-family:var(--font-mono); font-size:13px;
  padding:var(--space-3) var(--space-5);
  border:1px solid var(--border); background:transparent; color:var(--text-secondary);
  border-radius:var(--radius-sm); cursor:pointer; transition:.2s;
  display:flex; align-items:center; gap:var(--space-2) }
.mode-btn:hover{ border-color:var(--accent); color:var(--text-primary) }
.mode-btn.is-bad.on{ background:var(--err-soft); color:var(--err); border-color:var(--err); font-weight:700 }
.mode-btn.is-good.on{ background:var(--ok-soft); color:var(--ok); border-color:var(--ok); font-weight:700 }
.mode-btn .mode-marker{ width:8px; height:8px; border-radius:50%; background:currentColor; opacity:0.7 }

.nplus1-stage{ display:grid; grid-template-columns:1fr; gap:var(--space-4); margin-bottom:var(--space-4) }
@media (min-width:980px){
  .nplus1-stage{ grid-template-columns:1.1fr 1fr }
}

.q-timeline{ background:var(--surface-1); border:1px solid var(--border);
  border-radius:var(--radius-md); padding:var(--space-5);
  position:relative; min-height:380px }
.q-timeline-header{ display:flex; align-items:center; justify-content:space-between;
  margin-bottom:var(--space-4) }
.q-timeline-header h4{ font-family:var(--font-mono); font-size:13px;
  color:var(--text-secondary); font-weight:600; letter-spacing:0.04em }
.q-timeline-stats{ font-family:var(--font-mono); font-size:12px;
  display:flex; gap:var(--space-4); color:var(--text-muted) }
.q-timeline-stats .stat{ display:flex; align-items:center; gap:var(--space-2) }
.q-timeline-stats .stat-num{ font-size:20px; font-weight:700; font-feature-settings:'tnum' }
.q-timeline-stats .stat-num.is-bad{ color:var(--err) }
.q-timeline-stats .stat-num.is-good{ color:var(--ok) }

.q-list{ list-style:none; padding:0; margin:0; position:relative }
.q-list::before{ content:''; position:absolute; left:8px; top:6px; bottom:6px;
  width:1px; background:var(--border); }
.q-item{ position:relative; padding:0 0 var(--space-3) var(--space-5);
  font-family:var(--font-mono); font-size:12px; line-height:1.5;
  color:var(--text-muted); opacity:0; transform:translateY(4px);
  transition:opacity .25s ease, transform .25s ease }
.q-item.shown{ opacity:1; transform:none }
.q-item::before{ content:''; position:absolute; left:5px; top:5px; width:7px; height:7px;
  border-radius:50%; background:var(--text-muted); }
.q-item.is-main::before{ background:var(--accent); box-shadow:0 0 0 3px var(--accent-soft) }
.q-item.is-relation::before{ background:var(--err) }
.q-item.is-eager::before{ background:var(--ok); box-shadow:0 0 0 3px var(--ok-soft) }
.q-item .q-num{ display:inline-block; min-width:30px;
  color:var(--text-muted); font-size:11px; margin-right:var(--space-2) }
.q-item .q-sql{ color:var(--text-primary) }
.q-item .skw{ color:var(--accent-secondary); font-weight:700 }
.q-item .stbl{ color:var(--accent) }
.q-item .sval{ color:var(--ok) }
.q-item .q-tag{ font-size:10px; padding:1px 6px; border-radius:3px;
  margin-left:var(--space-2); font-weight:700; letter-spacing:0.04em }
.q-item .q-tag.is-bad{ background:var(--err-soft); color:var(--err) }
.q-item .q-tag.is-good{ background:var(--ok-soft); color:var(--ok) }
.q-list-foot{ margin-top:var(--space-4); padding-top:var(--space-3);
  border-top:1px dashed var(--border); font-family:var(--font-mono); font-size:11px;
  color:var(--text-muted); display:flex; align-items:center; gap:var(--space-3); flex-wrap:wrap }
.q-list-foot.is-bad{ color:var(--err) }
.q-list-foot.is-good{ color:var(--ok) }
.q-list-foot strong{ color:inherit; font-weight:700 }

.python-side .code-panel{ height:100% }
.python-side .code-panel pre.code-block{ height:calc(100% - 32px); }

.q-control{ background:var(--surface-0); border:1px solid var(--border);
  border-radius:var(--radius-md); padding:var(--space-3) var(--space-4);
  display:flex; align-items:center; gap:var(--space-4); flex-wrap:wrap;
  font-family:var(--font-mono); font-size:12px }
.q-control label{ display:flex; align-items:center; gap:var(--space-2); color:var(--text-secondary) }
.q-control input[type=range]{ accent-color:var(--accent); width:120px }
.q-control .num-display{ color:var(--accent); font-weight:700; min-width:24px;
  text-align:right; font-feature-settings:'tnum' }
.q-control button{ font-family:var(--font-mono); font-size:11px;
  padding:6px 14px; background:transparent; color:var(--text-secondary);
  border:1px solid var(--border); border-radius:var(--radius-sm); cursor:pointer; transition:.15s }
.q-control button:hover{ border-color:var(--accent); color:var(--text-primary) }
.q-control button.is-primary{ background:var(--accent); color:var(--accent-fg);
  border-color:var(--accent); font-weight:700 }

.diff-wrap{ display:grid; grid-template-columns:1fr; gap:var(--space-4) }
@media (min-width:900px){ .diff-wrap{ grid-template-columns:1fr 1fr } }
.diff-token{ background:var(--accent-soft); color:var(--accent);
  padding:0 4px; border-radius:3px; font-weight:700 }

.advanced-toggle{ background:var(--surface-1); border:1px solid var(--border);
  border-radius:var(--radius-md); margin-top:var(--space-4) }
.advanced-toggle summary{ padding:var(--space-4) var(--space-5); cursor:pointer;
  font-family:var(--font-mono); font-size:13px; color:var(--accent);
  list-style:none; display:flex; align-items:center; gap:var(--space-3); user-select:none }
.advanced-toggle summary::-webkit-details-marker{ display:none }
.advanced-toggle summary::before{ content:'▶'; font-size:10px; color:var(--text-muted);
  transition:transform .2s }
.advanced-toggle[open] summary::before{ transform:rotate(90deg); color:var(--accent) }
.advanced-toggle summary:hover{ background:var(--surface-2) }
.advanced-content{ padding:0 var(--space-5) var(--space-5); border-top:1px solid var(--border) }
.advanced-content > *:first-child{ margin-top:var(--space-4) }

.er-mini{ background:var(--surface-1); border:1px solid var(--border);
  border-radius:var(--radius-md); padding:var(--space-5); margin:var(--space-4) 0;
  display:flex; align-items:center; justify-content:center; gap:var(--space-7); flex-wrap:wrap;
  font-family:var(--font-mono) }
.er-table{ background:var(--surface-2); border:1.5px solid var(--border-strong);
  border-radius:var(--radius-md); min-width:160px }
.er-table-name{ background:var(--accent); color:var(--accent-fg); padding:6px 12px;
  font-size:12px; font-weight:700; border-radius:5px 5px 0 0; letter-spacing:0.04em }
.er-table.is-blue .er-table-name{ background:var(--accent-secondary); color:var(--accent-fg) }
.er-table.is-soft .er-table-name{ background:var(--info); color:var(--accent-fg) }
.er-table-fields{ padding:var(--space-2) var(--space-3); font-size:11px; color:var(--text-secondary) }
.er-table-fields div{ padding:3px 0 }
.er-table-fields div.is-pk{ color:var(--accent); font-weight:700 }
.er-table-fields div.is-fk{ color:var(--accent-secondary) }
.er-arrow{ font-family:var(--font-mono); color:var(--text-secondary); font-size:14px;
  display:flex; flex-direction:column; align-items:center; gap:2px }
.er-arrow .er-arrow-label{ font-size:10px; color:var(--text-muted); letter-spacing:0.04em }
.er-arrow .er-arrow-glyph{ font-size:18px; color:var(--accent) }

.pair-table{ width:100%; border-collapse:collapse; font-family:var(--font-mono); font-size:12px;
  margin-top:var(--space-4); background:var(--surface-1);
  border:1px solid var(--border); border-radius:var(--radius-md); overflow:hidden }
.pair-table th,.pair-table td{ padding:10px 14px; text-align:left;
  border-bottom:1px solid var(--border); border-right:1px solid var(--border);
  vertical-align:top }
.pair-table th{ background:var(--surface-2); color:var(--text-muted);
  font-weight:600; font-size:11px; letter-spacing:0.06em; text-transform:uppercase }
.pair-table th:first-child,.pair-table td:first-child{ color:var(--text-primary); font-weight:700 }
.pair-table tr:last-child td{ border-bottom:none }
.pair-table td:last-child,.pair-table th:last-child{ border-right:none }
.pair-table .async-tag{ color:var(--accent); font-weight:700 }

.cross-links{ display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:var(--space-3); margin-top:var(--space-5) }
.x-link{ background:var(--surface-1); border:1px solid var(--border);
  border-radius:var(--radius-md); padding:var(--space-4) var(--space-5);
  text-decoration:none; transition:.2s; display:block }
.x-link:hover{ border-color:var(--accent); transform:translateY(-1px); text-decoration:none }
.x-link .x-eyebrow{ font-family:var(--font-mono); font-size:10px;
  color:var(--accent); letter-spacing:0.12em; text-transform:uppercase; margin-bottom:var(--space-2) }
.x-link .x-title{ color:var(--text-primary); font-weight:600; margin-bottom:6px; font-size:15px }
.x-link .x-desc{ color:var(--text-secondary); font-size:12px; line-height:1.5 }

@media (max-width:680px){
  .hero{ padding:var(--space-7) 0 var(--space-5) }
  .nplus1-stage{ grid-template-columns:1fr }
}
</style>

<main class="container">

<!-- ============ hero ============ -->
<section class="hero reveal">
  <div class="eyebrow">04 / 06 · activerecord/relations.html · f4 CTA</div>
  <h1>关系 (Relations)。<br>不是 SQL 之上的<em>装饰</em>,<br>是 Python 之内的<em>引用</em>。</h1>
  <p class="lead">
    <code>has_many</code>、<code>belongs_to</code>、<code>has_one</code>、<code>through</code>——
    在 ActiveRecord 里这些不是"魔法",而是 <b>Python 描述符协议 + Pydantic ClassVar</b> 的两段简单组合。
    本页演示三种基本关系、多对多 through、以及最常见的性能陷阱 <b>N+1 问题</b> 的可视化解法。
  </p>
  <div class="hero-pills">
    <span class="pill">f4 / Relations CTA</span>
    <span class="pill is-secondary">A9 NPlusOneVisualizer</span>
    <span class="pill is-secondary">A2 ChainBuilder</span>
    <span class="pill is-ghost">A7 PluggableSlot</span>
    <span class="pill is-ghost">A3 SyncAsyncDiff</span>
  </div>
</section>

<!-- ============ 01 三种基本关系 ============ -->
<section class="sect reveal" id="basic">
  <span class="sect-tag">01 · BASIC RELATIONS</span>
  <h2>三种基本关系,<em>语义即名字</em>。</h2>
  <p class="intro">
    Rails 用了 20 年验证过的命名约定: <b>has_many</b>、<b>belongs_to</b>、<b>has_one</b>。
    站在哪一侧,关系名就反映那一侧的<b>视角</b>。AR 不发明新词,只把它们落到 Pydantic 字段上。
  </p>

  <div class="rel-grid">
    <div class="rel-card">
      <div class="rel-icon">1 ─── *</div>
      <h3>has_many</h3>
      <div class="rel-desc">"我有多个": <code>User</code> 一个用户,可以有多条 <code>Order</code>。外键在<b>多的一侧</b>。</div>
      <div class="rel-pair"><b>User</b>.orders → list[<b>Order</b>]</div>
    </div>
    <div class="rel-card is-belongs">
      <div class="rel-icon">* ─── 1</div>
      <h3>belongs_to</h3>
      <div class="rel-desc">"我属于一个": <code>Order</code> 反过来引用所属的 <code>User</code>。外键在<b>当前侧</b>。</div>
      <div class="rel-pair"><b>Order</b>.user → <b>User</b></div>
    </div>
    <div class="rel-card is-has-one">
      <div class="rel-icon">1 ─── 1</div>
      <h3>has_one</h3>
      <div class="rel-desc">"我有唯一的一个": <code>User</code> 有唯一的 <code>Profile</code>。<b>有 unique 约束</b>。</div>
      <div class="rel-pair"><b>User</b>.profile → <b>Profile</b></div>
    </div>
  </div>

  <!-- code with sync/async tabs -->
  <div style="margin-top:var(--space-5)">
    <div class="tabs-row" data-tabset="basic-rel">
      <button class="tab-btn on" data-tab="py310-async">3.10+ async</button>
      <button class="tab-btn" data-tab="py310-sync">3.10+ sync</button>
      <button class="tab-btn" data-tab="py38-async">3.8 async</button>
      <button class="tab-btn" data-tab="py38-sync">3.8 sync</button>
    </div>

    <div class="code-panel">
      <div class="code-panel-header"><span class="dot"></span><span>models.py · 关系定义</span></div>

      <div class="tab-pane on" data-tab="py310-async">
<pre class="code-block"><span class="kw">from</span> rhosocial.activerecord <span class="kw">import</span> ActiveRecord, AsyncActiveRecord
<span class="kw">from</span> rhosocial.activerecord.relation <span class="kw">import</span> HasMany, BelongsTo, HasOne
<span class="kw">from</span> typing <span class="kw">import</span> ClassVar, Optional

