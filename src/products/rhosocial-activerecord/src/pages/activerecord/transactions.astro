    div.dataset.idx = idx;
    div.style.opacity = '0';
    div.style.transform = 'translateY(4px)';
    div.innerHTML = '<div class="lc-tx-head"><span class="lc-tx-name">' + tx.name + '</span><span class="lc-tx-tag is-running">RUNNING</span></div><ul class="lc-tx-stmts"></ul>';
    lcContainer.appendChild(div);
  });
}

function renderPython(scen, currentLine) {
  if (currentLine === undefined) currentLine = -1;
  lcPyTitle.textContent = scen.pyTitle;
  lcPy.innerHTML = scen.pyLines.map(function(line, i) {
    var cls = (i === currentLine) ? 'code-line is-current' : 'code-line';
    return '<span class="' + cls + '">' + (line || '&nbsp;') + '</span>';
  }).join('\\n');
}

function applyScenario(scenKey) {
  var scen = scenarios[scenKey];
  currentScen = scenKey;
  currentStep = 0;
  if (playTimer) { clearInterval(playTimer); playTimer = null; playBtn.textContent = '▶ 播放'; }
  lcTitle.textContent = scen.title;
  buildTimeline(scen);
  renderPython(scen, -1);
  lcStepTotal.textContent = scen.steps.length;
  lcStepNow.textContent = 0;
  scenBtns.forEach(function(b) { b.classList.toggle('on', b.dataset.scenario === scenKey); });
}

function applyStep(idx) {
  var scen = scenarios[currentScen];
  if (idx > scen.steps.length) return;
  buildTimeline(scen);
  for (var i = 0; i < idx; i++) {
    var step = scen.steps[i];
    var txDiv = lcContainer.querySelector('.lc-tx[data-idx="' + step.txIdx + '"]');
    if (txDiv) {
      txDiv.style.opacity = '1';
      txDiv.style.transform = 'translateY(0)';
      var stmtList = txDiv.querySelector('.lc-tx-stmts');
      var li = document.createElement('li');
      li.className = 'lc-stmt ' + step.type + ' shown';
      li.innerHTML = step.sql;
      stmtList.appendChild(li);
      if (step.txStateAfter) {
        step.txStateAfter.forEach(function(s) {
          var tDiv = lcContainer.querySelector('.lc-tx[data-idx="' + s.idx + '"]');
          if (tDiv) {
            tDiv.classList.remove('committed', 'rolled-back', 'partial-rollback');
            var tag = tDiv.querySelector('.lc-tx-tag');
            if (s.state === 'committed') {
              tDiv.classList.add('committed');
              tag.className = 'lc-tx-tag is-committed';
              tag.textContent = 'COMMITTED';
            } else if (s.state === 'rolled-back') {
              tDiv.classList.add('rolled-back');
              tag.className = 'lc-tx-tag is-rolled-back';
              tag.textContent = 'ROLLED BACK';
            } else if (s.state === 'is-running') {
              tag.className = 'lc-tx-tag is-running';
              tag.textContent = 'RUNNING';
            }
          }
        });
      }
    }
  }
  var lastStep = scen.steps[idx - 1];
  renderPython(scen, lastStep ? lastStep.codeLine : -1);
  currentStep = idx;
  lcStepNow.textContent = idx;
}

scenBtns.forEach(function(b) { b.addEventListener('click', function() { applyScenario(b.dataset.scenario); }); });

stepBtn.addEventListener('click', function() {
  var scen = scenarios[currentScen];
  if (currentStep < scen.steps.length) { applyStep(currentStep + 1); }
});

playBtn.addEventListener('click', function() {
  if (playTimer) {
    clearInterval(playTimer); playTimer = null;
    playBtn.textContent = '▶ 播放';
    return;
  }
  if (currentStep >= scenarios[currentScen].steps.length) { currentStep = 0; }
  playBtn.textContent = '⏸ 暂停';
  playTimer = setInterval(function() {
    var scen = scenarios[currentScen];
    if (currentStep < scen.steps.length) {
      applyStep(currentStep + 1);
    } else {
      clearInterval(playTimer); playTimer = null;
      playBtn.textContent = '▶ 播放';
    }
  }, 900);
});

resetBtn.addEventListener('click', function() {
  if (playTimer) { clearInterval(playTimer); playTimer = null; playBtn.textContent = '▶ 播放'; }
  applyStep(0);
});

applyScenario('success');
</script>

