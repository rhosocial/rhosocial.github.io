---
import BaseLayout from '../../layouts/BaseLayout.astro';
const __html = `<style>
:root, body {
  --code-keyword:   var(--tok-keyword);
  --code-class:     var(--tok-class);
  --code-fn:        var(--tok-func);
  --code-string:    var(--tok-string);
  --code-number:    var(--tok-num);
  --code-comment:   var(--tok-comment);
  --code-op:        var(--tok-op);
  --surface-0:      var(--bg-2);
  --surface-1:      var(--bg-elevated);
  --surface-2:      var(--bg-2);
  --surface-3:      color-mix(in srgb, var(--fg) 8%, var(--bg));
  --text-primary:   var(--fg);
  --text-secondary: var(--fg-muted);
  --text-muted:     var(--fg-faint);
  --accent-soft:    color-mix(in srgb, var(--accent) 15%, transparent);
  --accent-secondary:      var(--accent-2);
  --accent-secondary-soft: color-mix(in srgb, var(--accent-2) 12%, transparent);
  --accent-fg:      var(--bg);
  --ok:             var(--success);
  --ok-soft:        color-mix(in srgb, var(--success) 12%, transparent);
  --err:            var(--danger);
  --err-soft:       color-mix(in srgb, var(--danger) 12%, transparent);
  --info:           var(--info);
  --warn:           var(--warning, #f59e0b);
  --warn-soft:      color-mix(in srgb, var(--warning, #f59e0b) 12%, transparent);
  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px;
  --space-5: 24px; --space-6: 32px; --space-7: 48px; --space-8: 64px;
  --radius-sm: 4px; --radius-md: 8px; --radius-lg: 12px; --radius-pill: 9999px;
}
.reveal { opacity:0; transform:translateY(24px); transition:opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }
.reveal-d1 { transition-delay:0.1s; }
.reveal-d2 { transition-delay:0.2s; }
</style>
<main class="page">
  <section class="hero section reveal">
    <div class="container hero-inner">
      <div class="hero-eyebrow rise"><a href="./index.html">&larr; <span data-i18n="hero.back">ActiveRecord</span></div>
      <h1 class="hero-title rise">Migrations</h1>
      <p class="hero-sub rise" data-i18n="hero.sub">版本化数据库模式变更。</p>
    </div>
  </section>
  <section class="section reveal reveal-d1">
    <div class="container">
      <div class="section-header">
        <div class="section-label" data-i18n="class.label">Migration</div>
        <h2 class="section-title" data-i18n="class.title">迁移类。</h2>
      </div>
      <div class="code-block" style="margin-top: 24px;"><div class="code-header"><div class="code-dots"><span></span><span></span><span></div><span class="code-filename">migrations/001_create_users.py</span></div>
        <div class="code-body"><pre><span class="tok-kw">from</span> rhosocial.activerecord.devtools.migration <span class="tok-kw">import</span> <span class="tok-cls">Migration</span>

<span class="tok-kw">class</span> <span class="tok-cls">CreateUsersTable</span>(<span class="tok-cls">Migration</span>):
    revision = <span class="tok-s">'001'</span>
    down_revision = <span class="tok-kw">None</span>
    
    <span class="tok-kw">def</span> <span class="tok-func">up</span>(self):
        self.create_table(<span class="tok-s">'users'</span>, [
            <span class="tok-cls">Column</span>(<span class="tok-s">'id'</span>, <span class="tok-cls">Integer</span>, primary_key=<span class="tok-kw">True</span>),
            <span class="tok-cls">Column</span>(<span class="tok-s">'username'</span>, <span class="tok-cls">String</span>(<span class="tok-num">50</span>), nullable=<span class="tok-kw">False</span>),
            <span class="tok-cls">Column</span>(<span class="tok-s">'email'</span>, <span class="tok-cls">String</span>(<span class="tok-num">100</span>), unique=<span class="tok-kw">True</span>),
        ])
    
    <span class="tok-kw">def</span> <span class="tok-func">down</span>(self):
        self.drop_table(<span class="tok-s">'users'</span>)</pre></div>
      </div>
    </div>
  </section>
  <section class="section reveal reveal-d1">
    <div class="container">
      <div class="section-header">
        <div class="section-label" data-i18n="cli.label">CLI</div>
        <h2 class="section-title" data-i18n="cli.title">命令行工具。</h2>
      </div>
      <div class="code-block" style="margin-top: 24px;"><div class="code-header"><div class="code-dots"><span></span><span></span><span></div><span class="code-filename">shell</span></div>
        <div class="code-body"><pre><span class="tok-c"># 升级到最新版本</span>
$ arcli migrate upgrade

<span class="tok-c"># 降级一个版本</span>
$ arcli migrate downgrade -1

<span class="tok-c"># 查看迁移历史</span>
$ arcli migrate history</pre></div>
      </div>
    </div>
  </section></main>
<script>
(function(){var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){e.target.classList.add("visible");o.unobserve(e.target)}})},{threshold:.12});document.querySelectorAll(".reveal").forEach(function(e){o.observe(e)})})();void 0
</script>`;
---

<BaseLayout title="rhosocial ActiveRecord — Migrations" variant="ar">
  <Fragment set:html={__html} />
</BaseLayout>
